                <a href="{{ a.page }}" class="blog-index-card blog-index-card--{{ a.color }}">
                    <div class="blog-index-meta">
                        <span class="blog-index-app">{{ a.name }}</span>
                    </div>
                    <div class="blog-index-title">{{ a.tagline }}</div>
                    <p class="blog-index-excerpt">Free on iOS · {{ a.os }}</p>
                </a>
{%- endfor %}
            </div>
        </div>
    </main>

{% include "partials/footer.njk" %}
