{%- set pageLang = lang or "en" -%}
{%- set str = strings[pageLang] -%}
{%- set langPrefix = ("/" + pageLang) if pageLang != "en" else "" -%}
    <footer class="site-footer">
        <div class="container">
            <div class="footer-brand">{{ footerAppData.footerBrand if footerAppData else site.name }}</div>
{%- if showFooterIcons %}
            <div class="footer-icons">
                {%- for a in apps %}
                <a href="{{ langPrefix }}{{ a.page }}" aria-label="{{ a.name }}">
                    <img src="{{ a.icon128 }}" alt="{{ a.name }}" width="36" height="36">
                </a>
                {%- endfor %}
            </div>
{%- endif %}
            <div class="footer-links">
{%- if footerAppData %}
                <a href="{{ footerAppData.privacy }}">{{ str.privacyPolicy }}</a>
{%- endif %}
                <a href="/blog/">{{ str.blog }}</a>
                <a href="/guides/">{{ str.guides }}</a>
{%- for a in apps %}{% if not footerAppData or a.key != footerAppData.key %}
                <a href="{{ langPrefix }}{{ a.page }}">{{ a.name }}</a>
{%- endif %}{% endfor %}
                <a href="/about.html">{{ str.about }}</a>
                <a href="mailto:{{ site.email }}">{{ str.contact }}</a>
            </div>
{%- if showFooterEmail %}
            <div class="footer-email"><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
{%- endif %}
{%- if alternates %}
{%- set langNames = { "en": "English", "fr": "Français", "de": "Deutsch" } %}
            <nav class="footer-langs" aria-label="{{ str.language }}">
                {%- for alt in alternates %}{% if alt.lang != "x-default" %}
                <a href="{{ alt.href }}" hreflang="{{ alt.lang }}" lang="{{ alt.lang }}"{% if alt.lang == pageLang %} aria-current="page"{% endif %}>{{ langNames[alt.lang] }}</a>
                {%- endif %}{% endfor %}
            </nav>
{%- endif %}
            <div class="footer-made-in">{{ str.madeInCanada }} 🇨🇦</div>
            <div class="footer-copy">© {{ site.copyrightYear }} {{ site.name }}.{% if footerAppData %} {{ footerAppData.footerCopy }}{% endif %}</div>
        </div>
    </footer>
